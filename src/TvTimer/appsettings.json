{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "/var/log/tvtimer/tvtimer-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 14,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "Sony": {
    "TvIp": "",
    "ClientId": "TvTimer",
    "Nickname": "TvTimer",
    "AuthCookiePath": "/var/lib/tvtimer/auth-cookie.txt",
    "Psk": "",
    "UseHttps": false,
    "CaCertPath": ""
  },
  "Schedule": {
    "CronExpression": "30 22 * * 0-4",
    "TimeZoneId": "Etc/UTC"
  }
}
